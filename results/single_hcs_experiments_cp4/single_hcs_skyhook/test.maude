  --- UDP transport for DNS resolvers
  eq transport(publicDnsAddr) = publicDnsAddr .
  eq transport(corpMasDnsAddr) = corpMasDnsAddr .
  eq transport(corpRtDnsAddr) = corpRtDnsAddr .
  eq transport(corpObfsDnsAddr) = corpObfsDnsAddr .
  eq transport(corpSkyDnsAddr) = corpSkyDnsAddr .
  eq transport(corpIodDnsAddr) = corpIodDnsAddr .
  eq transport(servDnsAddr) = servDnsAddr .


  ---------------------------------------------------
  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- Skyhook Client 1
    aaa(skyCl1SdkacAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, skyCl1SdkacAddr, LinkType-ClientNetSky)
    aaa(skyCl1SdkasAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, skyCl1SdkasAddr, LinkType-ServerNet)
    --- Skyhook Client 2
    aaa(skyCl2SdkacAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky)
    aaa(IXP-DEFAULT-ADDR, skyCl2SdkacAddr, LinkType-ClientNetSky)
    aaa(skyCl2SdkasAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, skyCl2SdkasAddr, LinkType-ServerNet)
    aaa(corpSkyNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyNetClAddr, LinkType-ClientNetSky-Dns)
    aaa(corpSkyNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpSkyNetClAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(corpSkyNetClAddr, publicDnsAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(publicDnsAddr, corpSkyNetClAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(corpSkyDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyDnsAddr, LinkType-ClientNetSky-Dns)
    aaa(corpSkyDnsAddr, publicDnsAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(publicDnsAddr, corpSkyDnsAddr, LinkType-ClientNetSky-DnsComposed)

    --- Minio/S3 server
    aaa(s3SrvAddr, IXP-DEFAULT-ADDR, LinkType-MinioNet)
    aaa(IXP-DEFAULT-ADDR, s3SrvAddr, LinkType-MinioNet)

    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet-Dns)
    aaa(IXP-DEFAULT-ADDR, servDnsAddr, LinkType-ServerNet-Dns)
    aaa(servDnsAddr, publicDnsAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicDnsAddr, servDnsAddr, LinkType-ServerNet-DnsComposed)
    aaa(servNetClAddr, publicResolverNetSrvAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicResolverNetSrvAddr, servNetClAddr, LinkType-ServerNet-DnsComposed)
    aaa(servNetClAddr, publicDnsAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicDnsAddr, servNetClAddr, LinkType-ServerNet-DnsComposed)
    aaa(publicDnsAddr, IXP-DEFAULT-ADDR, LinkType-DnsNet-Dns)
    aaa(IXP-DEFAULT-ADDR, publicDnsAddr, LinkType-DnsNet-Dns)

    aaa(ircServerAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, ircServerAddr, LinkType-ServerNet)

    --- TGEN Direct Links





    --- TGEN IXP Links
    aaa(ftpSrvAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, ftpSrvAddr, LinkType-ServerNet)
    aaa(gorillaSrvAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet)
    aaa(IXP-DEFAULT-ADDR, gorillaSrvAddr, LinkType-ServerNet)
  .

  ---------------------------------------------------
  --- Visibility Map
  ---------------------------------------------------
  eq visibilityMap =
  (cl[1] |-> (
      skyCl1SdkacAddr ;; skyCl2SdkacAddr ;; corpSkyNetClAddr ;; corpSkyDnsAddr
    )) ,
  (dnsN |-> (
      publicResolverNetSrvAddr ;; publicDnsAddr
    )) ,
  (minN |-> s3SrvAddr) ,
  (srvN |-> (
      skyCl1SdkasAddr ;; skyCl2SdkasAddr ;; servDnsAddr ;; servNetClAddr
      ;; ircServerAddr ;; ftpSrvAddr ;; gorillaSrvAddr
    ))
  .

  ---------------------------------------------------
  --- Actor Declarations & Definitions
  ---------------------------------------------------

  --- Skyhook Client 1 (IRC profile: irc_casualchat)
  ops skyCl1Irc skyCl1Um skyCl1Iface skyCl1SrvIface : -> Actor .
  ops skyCl1UmacAct skyCl1CmacAct skyCl1PuaAct skyCl1SdkacAct : -> Actor .
  ops skyCl1UmasAct skyCl1CmasAct skyCl1AhaAct skyCl1SdkasAct : -> Actor .
  ops skyCl1ClNet skyCl1SrvNetCl skyCl1NetSrv : -> Actor .
  eq skyCl1Irc       = mkIrcClient-v2(skyCl1IrcAddr, skyCl1IfaceAddr, "SkyClient1") .
  eq skyCl1Um        = mkIrcUMV2Actor(skyCl1UmAddr, "irc-irc-casualchat", skyCl1IrcAddr, ircServerAddr, skyCl1SrvIfaceAddr) .
  eq skyCl1Iface     = mkIrcByteSeqIface(skyCl1IfaceAddr, skyCl1IrcAddr, skyCl1CmacAddr) .
  eq skyCl1UmacAct   = mkUMactor(skyCl1UmacAddr, skyhook-skyhook-client-scenario-1-ma, skyCl1CmacAddr) .
  eq skyCl1CmacAct   = mkCMSimpleBi(skyCl1CmacAddr, skyCl1IfaceAddr, skyCl1PuaAddr) .
  eq skyCl1PuaAct    = makeSkyhookPU(skyCl1PuaAddr, skyCl1CmacAddr, skyCl1SdkacAddr, "s_to_c_bucket_1", "c_to_s_bucket_1", "0", "1") .
  eq skyCl1SdkacAct  = makeS3Client(skyCl1SdkacAddr, s3SrvAddr) .
  eq skyCl1SrvIface  = mkIrcByteSeqIface(skyCl1SrvIfaceAddr, ircServerAddr, skyCl1CmasAddr) .
  eq skyCl1UmasAct   = mkUMactor(skyCl1UmasAddr, skyhook-skyhook-server-scenario-1-ma, skyCl1CmasAddr) .
  eq skyCl1CmasAct   = mkCMSimpleBi(skyCl1CmasAddr, skyCl1SrvIfaceAddr, skyCl1AhaAddr) .
  eq skyCl1AhaAct    = mkSkyhookAH(skyCl1AhaAddr, skyCl1CmasAddr, skyCl1SdkasAddr, "c_to_s_bucket_1", "s_to_c_bucket_1", "0", "0", "0", 100) .
  eq skyCl1SdkasAct  = makeS3Client(skyCl1SdkasAddr, s3SrvAddr) .
  eq skyCl1ClNet     = makeNetClient(skyCl1ClNetAddr,
                                       s3SrvAddr,
                                       skyCl1SdkacAddr,
                                       false,
                                       corpSkyDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq skyCl1NetSrv    = makeNetServer(skyCl1NetSrvAddr, s3SrvAddr) .
  eq skyCl1SrvNetCl  = makeNetClient(skyCl1SrvNetClAddr,
                                       s3SrvAddr,
                                       skyCl1SdkasAddr,
                                       true,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Skyhook Client 2 (IRC profile: irc_casualchat)
  ops skyCl2Irc skyCl2Um skyCl2Iface skyCl2SrvIface : -> Actor .
  ops skyCl2UmacAct skyCl2CmacAct skyCl2PuaAct skyCl2SdkacAct : -> Actor .
  ops skyCl2UmasAct skyCl2CmasAct skyCl2AhaAct skyCl2SdkasAct : -> Actor .
  ops skyCl2ClNet skyCl2SrvNetCl skyCl2NetSrv : -> Actor .
  eq skyCl2Irc       = mkIrcClient-v2(skyCl2IrcAddr, skyCl2IfaceAddr, "SkyClient2") .
  eq skyCl2Um        = mkIrcUMV2Actor(skyCl2UmAddr, "irc-irc-casualchat", skyCl2IrcAddr, ircServerAddr, skyCl2SrvIfaceAddr) .
  eq skyCl2Iface     = mkIrcByteSeqIface(skyCl2IfaceAddr, skyCl2IrcAddr, skyCl2CmacAddr) .
  eq skyCl2UmacAct   = mkUMactor(skyCl2UmacAddr, skyhook-skyhook-client-scenario-1-ma, skyCl2CmacAddr) .
  eq skyCl2CmacAct   = mkCMSimpleBi(skyCl2CmacAddr, skyCl2IfaceAddr, skyCl2PuaAddr) .
  eq skyCl2PuaAct    = makeSkyhookPU(skyCl2PuaAddr, skyCl2CmacAddr, skyCl2SdkacAddr, "s_to_c_bucket_2", "c_to_s_bucket_2", "0", "1") .
  eq skyCl2SdkacAct  = makeS3Client(skyCl2SdkacAddr, s3SrvAddr) .
  eq skyCl2SrvIface  = mkIrcByteSeqIface(skyCl2SrvIfaceAddr, ircServerAddr, skyCl2CmasAddr) .
  eq skyCl2UmasAct   = mkUMactor(skyCl2UmasAddr, skyhook-skyhook-server-scenario-1-ma, skyCl2CmasAddr) .
  eq skyCl2CmasAct   = mkCMSimpleBi(skyCl2CmasAddr, skyCl2SrvIfaceAddr, skyCl2AhaAddr) .
  eq skyCl2AhaAct    = mkSkyhookAH(skyCl2AhaAddr, skyCl2CmasAddr, skyCl2SdkasAddr, "c_to_s_bucket_2", "s_to_c_bucket_2", "0", "0", "0", 100) .
  eq skyCl2SdkasAct  = makeS3Client(skyCl2SdkasAddr, s3SrvAddr) .
  eq skyCl2ClNet     = makeNetClient(skyCl2ClNetAddr,
                                       s3SrvAddr,
                                       skyCl2SdkacAddr,
                                       false,
                                       corpSkyDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .
  eq skyCl2NetSrv    = makeNetServer(skyCl2NetSrvAddr, s3SrvAddr) .
  eq skyCl2SrvNetCl  = makeNetClient(skyCl2SrvNetClAddr,
                                       s3SrvAddr,
                                       skyCl2SdkasAddr,
                                       true,
                                       servDnsAddr,
                                       'mastodon . 'pwnd . 'com . root) .

  --- Base Infrastructure
  ops ircServer s3SrvAct advActor masNetSrv masSrvAct : -> Actor .
  eq ircServer      = mkIrcServer(ircServerAddr) .
  eq s3SrvAct       = 
    < s3SrvAddr : AwsS3HttpServer |
        thisAddr: s3SrvAddr,
        s3DataMap: (
          ("/tgen/list-1" -> restToByteSeq("obj1.zip;obj2.zip;data/")) ;
          ("/tgen/stat-1" -> restToByteSeq("obj1.zip:1024:2025-01-01")) ;
          ("/tgen/cd-1" -> restToByteSeq("subdir1/;subdir2/")) ;
          ("/tgen/retr-1" -> restToByteSeq("mock_file_content_bytes"))
        )
    >
  .
  eq masSrvAct      = makeMastodonServer(masSrvAddr) .
  eq masNetSrv       = makeNetServer(masNetSrvAddr, masSrvAddr) .
  eq advActor       = mkAdversaryCp3(advAddr, true) .

  --- DNS Infrastructure
  ops corpMasDns corpRtDns corpIodDns corpObfsDns corpSkyDns servDns : -> Actor .
  ops publicResolver rootDns tldDns authDns : -> Actor .
  ops corpMasNetCl corpRtNetCl corpIodNetCl corpObfsNetCl corpSkyNetCl servNetCl : -> Actor .
  ops publicResolverNetSrv : -> Actor .

  eq corpMasDns   = mkNameServer(corpMasDnsAddr, (zoneMasCom), corpMasNetClAddr) .
  eq corpRtDns    = mkNameServer(corpRtDnsAddr, (zoneRtCom), corpRtNetClAddr) .
  eq corpIodDns   = mkNameServer(corpIodDnsAddr, (zoneIodCom), corpIodNetClAddr) .
  eq corpObfsDns  = mkNameServer(corpObfsDnsAddr, (zoneObfsCom), corpObfsNetClAddr) .
  eq corpSkyDns   = mkNameServer(corpSkyDnsAddr, (zoneSkyCom), corpSkyNetClAddr) .
  eq servDns      = mkNameServer(servDnsAddr, (zoneServCom), servNetClAddr) .
  eq publicResolver = mkResolver(publicDnsAddr, resolverCache, sb) .
  eq rootDns       = mkNameServer(rootDnsAddr, (zone), nullAddr) .
  eq tldDns        = mkNameServer(tldDnsAddr, (zoneCom), nullAddr) .
  eq authDns       = mkNameServer(authDnsAddr, (zoneInternetCom), nullAddr) .

  eq corpMasNetCl = mkFwdDnsNetC(corpMasNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpMasDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpRtNetCl  = mkFwdDnsNetC(corpRtNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpRtDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpIodNetCl = mkFwdDnsNetC(corpIodNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr,
                                 corpIodDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq corpObfsNetCl  = mkFwdDnsNetC(corpObfsNetClAddr,
                                   publicResolverNetSrvAddr,
                                   publicDnsAddr,
                                   corpObfsDnsAddr,
                                   IXP-DEFAULT-ADDR)
  .
  eq corpSkyNetCl = mkFwdDnsNetC(corpSkyNetClAddr,
                                 publicResolverNetSrvAddr,
                                 publicDnsAddr, 
                                 corpSkyDnsAddr,
                                 IXP-DEFAULT-ADDR)
  .
  eq servNetCl  = mkFwdDnsNetC(servNetClAddr,
                               publicResolverNetSrvAddr,
                               publicDnsAddr,
                               servDnsAddr,
                               IXP-DEFAULT-ADDR)
  .
  eq publicResolverNetSrv = mkPubDnsNetS(publicResolverNetSrvAddr,
                                         publicDnsAddr,
                                         IXP-DEFAULT-ADDR)
  .

  ---------------------------------------------------
  --- TGEN Actor Definitions
  ---------------------------------------------------
  --- Shared TGEN Servers
  ops ftpSrvAct ftpNetSrvAct : -> Actor .
  eq ftpSrvAct     = mkFtpServerA(ftpSrvAddr) .
  eq ftpNetSrvAct  = makeNetServer(ftpNetSrvAddr, ftpSrvAddr) .

  ops gorillaSrvAct gorillaNetSrvAct : -> Actor .
  eq gorillaSrvAct   = mkGorillaChatServer(gorillaSrvAddr, (noAddr)) .
  eq gorillaNetSrvAct = makeNetServer(gorillaNetSrvAddr, gorillaSrvAddr) .

  ops ircTgenSrvNet : -> Actor .
  eq ircTgenSrvNet = makeNetServer(ircTgenSrvNetAddr, ircServerAddr) .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =

    --- Core Infrastructure
    ircServer s3SrvAct masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    corpRtDns corpRtNetCl

    --- Skyhook Client 1
    skyCl1Irc skyCl1Um skyCl1Iface skyCl1UmacAct skyCl1CmacAct skyCl1PuaAct skyCl1SdkacAct
    skyCl1SrvIface skyCl1UmasAct skyCl1CmasAct skyCl1AhaAct skyCl1SdkasAct
    skyCl1ClNet skyCl1NetSrv skyCl1SrvNetCl
    --- Skyhook Client 2
    skyCl2Irc skyCl2Um skyCl2Iface skyCl2UmacAct skyCl2CmacAct skyCl2PuaAct skyCl2SdkacAct
    skyCl2SrvIface skyCl2UmasAct skyCl2CmasAct skyCl2AhaAct skyCl2SdkasAct
    skyCl2ClNet skyCl2NetSrv skyCl2SrvNetCl
    corpSkyDns corpSkyNetCl

    corpObfsDns corpObfsNetCl

    corpIodDns corpIodNetCl

    corpMasDns corpMasNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- TGEN Shared Servers
    ftpSrvAct ftpNetSrvAct
    gorillaSrvAct gorillaNetSrvAct
    ircTgenSrvNet

    --- TGEN Instances

    --- Startup Timers

    [hcsDelay + genRandomX(j + 1, 0.0, 0.009), (to skyCl1AhaAddr from skyCl1AhaAddr : SkyhookStartCmd), 0]
    [hcsDelay + genRandomX(j + 2, 0.0, 0.009), (to skyCl1UmacAddr from skyCl1UmacAddr : actionR("ok")), 0]
    [hcsDelay + genRandomX(j + 3, 0.0, 0.009), (to skyCl1UmasAddr from skyCl1UmasAddr : actionR("ok")), 0]
    [hcsDelay + 10.0 + genRandomX(j + 4, 0.0, 0.009), (to skyCl1UmAddr from skyCl1UmAddr : burstDelayTO), 0]
    [hcsDelay + genRandomX(j + 5, 0.0, 0.009), (to skyCl2AhaAddr from skyCl2AhaAddr : SkyhookStartCmd), 0]
    [hcsDelay + genRandomX(j + 6, 0.0, 0.009), (to skyCl2UmacAddr from skyCl2UmacAddr : actionR("ok")), 0]
    [hcsDelay + genRandomX(j + 7, 0.0, 0.009), (to skyCl2UmasAddr from skyCl2UmasAddr : actionR("ok")), 0]
    [hcsDelay + 10.0 + genRandomX(j + 8, 0.0, 0.009), (to skyCl2UmAddr from skyCl2UmAddr : burstDelayTO), 0]

    --- TGEN User Model Burst Delay Timers (staggered)

    rCtr(j + 10)
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 610.0 [owise] .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = skyCl1IrcAddr ; skyCl2IrcAddr .
endm
eof
--- set print attribute on .
--- rew initConfig .
--- q