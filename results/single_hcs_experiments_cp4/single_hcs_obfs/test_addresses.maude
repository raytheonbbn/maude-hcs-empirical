  ops servDnsAddr : -> Address .
  ops corpMasNetClAddr corpRtNetClAddr corpIodNetClAddr corpObfsNetClAddr corpSkyNetClAddr : -> Address .
  ops servNetClAddr publicResolverNetSrvAddr : -> Address .

  ---------------------------------------------------
