  eq dnsTgenIod10UmAct  = mkUMactor(dnsTgenIod10UmAddr, dns-tgen-slow-3-ma, dnsTgenIod10TgAddr) .

  --- DNS TGEN: dnsTgenIod11 (profile=slow_3, network=client_net_iodine)
  ops dnsTgenIod11Act dnsTgenIod11UmAct : -> Actor .
  eq dnsTgenIod11Act    = mkDnsTgenA(dnsTgenIod11TgAddr, corpIodDnsAddr, 1000, 5.0, 2) .
  eq dnsTgenIod11UmAct  = mkUMactor(dnsTgenIod11UmAddr, dns-tgen-slow-3-ma, dnsTgenIod11TgAddr) .

  --- DNS TGEN: dnsTgenIod12 (profile=slow_3, network=client_net_iodine)
  ops dnsTgenIod12Act dnsTgenIod12UmAct : -> Actor .
  eq dnsTgenIod12Act    = mkDnsTgenA(dnsTgenIod12TgAddr, corpIodDnsAddr, 1000, 5.0, 2) .
  eq dnsTgenIod12UmAct  = mkUMactor(dnsTgenIod12UmAddr, dns-tgen-slow-3-ma, dnsTgenIod12TgAddr) .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =

    --- Core Infrastructure
    ircServer s3SrvAct iodineMonitor masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    corpRtDns corpRtNetCl

    corpSkyDns corpSkyNetCl

    corpObfsDns corpObfsNetCl

    corpIodDns corpIodNetCl

    corpMasDns corpMasNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- TGEN Shared Servers
    ftpSrvAct ftpNetSrvAct
    gorillaSrvAct gorillaNetSrvAct
    ircTgenSrvNet

    --- TGEN Instances
    dnsTgenIod1UmAct dnsTgenIod1Act
    dnsTgenIod2UmAct dnsTgenIod2Act
    dnsTgenIod3UmAct dnsTgenIod3Act
    dnsTgenIod4UmAct dnsTgenIod4Act
    dnsTgenIod5UmAct dnsTgenIod5Act
    dnsTgenIod6UmAct dnsTgenIod6Act
    dnsTgenIod7UmAct dnsTgenIod7Act
    dnsTgenIod8UmAct dnsTgenIod8Act
    dnsTgenIod9UmAct dnsTgenIod9Act
    dnsTgenIod10UmAct dnsTgenIod10Act
    dnsTgenIod11UmAct dnsTgenIod11Act
    dnsTgenIod12UmAct dnsTgenIod12Act

    --- Startup Timers


    --- TGEN User Model Burst Delay Timers (staggered)
    [tgenDelay + genRandomX(j + 1, 0.0, 0.009), (to dnsTgenIod1UmAddr from dnsTgenIod1UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 2, 0.0, 0.009), (to dnsTgenIod2UmAddr from dnsTgenIod2UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 3, 0.0, 0.009), (to dnsTgenIod3UmAddr from dnsTgenIod3UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 4, 0.0, 0.009), (to dnsTgenIod4UmAddr from dnsTgenIod4UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 5, 0.0, 0.009), (to dnsTgenIod5UmAddr from dnsTgenIod5UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 6, 0.0, 0.009), (to dnsTgenIod6UmAddr from dnsTgenIod6UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 7, 0.0, 0.009), (to dnsTgenIod7UmAddr from dnsTgenIod7UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 8, 0.0, 0.009), (to dnsTgenIod8UmAddr from dnsTgenIod8UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 9, 0.0, 0.009), (to dnsTgenIod9UmAddr from dnsTgenIod9UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 10, 0.0, 0.009), (to dnsTgenIod10UmAddr from dnsTgenIod10UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 11, 0.0, 0.009), (to dnsTgenIod11UmAddr from dnsTgenIod11UmAddr : actionR("ok")), 0]
    [tgenDelay + genRandomX(j + 12, 0.0, 0.009), (to dnsTgenIod12UmAddr from dnsTgenIod12UmAddr : actionR("ok")), 0]

    rCtr(j + 14)
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 610.0 [owise] .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = nil .
endm
