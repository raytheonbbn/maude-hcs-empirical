  --- Link Data (Readable Addresses Only)
  ---------------------------------------------------
  eq LinkData =
    --- Webtunnel corp
    aaa(corpRtNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetRacetunnel-Dns)
    aaa(IXP-DEFAULT-ADDR, corpRtNetClAddr, LinkType-ClientNetRacetunnel-Dns)
    aaa(corpRtNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetRacetunnel-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpRtNetClAddr, LinkType-ClientNetRacetunnel-DnsComposed)
    aaa(corpRtNetClAddr, publicDnsAddr, LinkType-ClientNetRacetunnel-DnsComposed)
    aaa(publicDnsAddr, corpRtNetClAddr, LinkType-ClientNetRacetunnel-DnsComposed)
    aaa(corpRtDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetRacetunnel-Dns)
    aaa(IXP-DEFAULT-ADDR, corpRtDnsAddr, LinkType-ClientNetRacetunnel-Dns)
    aaa(corpRtDnsAddr, publicDnsAddr, LinkType-ClientNetRacetunnel-DnsComposed)
    aaa(publicDnsAddr, corpRtDnsAddr, LinkType-ClientNetRacetunnel-DnsComposed)

    --- Obfs4 corp
    aaa(corpObfsNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsNetClAddr, LinkType-ClientNetObfs-Dns)
    aaa(corpObfsNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpObfsNetClAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(corpObfsNetClAddr, publicDnsAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(publicDnsAddr, corpObfsNetClAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(corpObfsDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetObfs-Dns)
    aaa(IXP-DEFAULT-ADDR, corpObfsDnsAddr, LinkType-ClientNetObfs-Dns)
    aaa(corpObfsDnsAddr, publicDnsAddr, LinkType-ClientNetObfs-DnsComposed)
    aaa(publicDnsAddr, corpObfsDnsAddr, LinkType-ClientNetObfs-DnsComposed)

    aaa(corpSkyNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyNetClAddr, LinkType-ClientNetSky-Dns)
    aaa(corpSkyNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpSkyNetClAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(corpSkyNetClAddr, publicDnsAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(publicDnsAddr, corpSkyNetClAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(corpSkyDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetSky-Dns)
    aaa(IXP-DEFAULT-ADDR, corpSkyDnsAddr, LinkType-ClientNetSky-Dns)
    aaa(corpSkyDnsAddr, publicDnsAddr, LinkType-ClientNetSky-DnsComposed)
    aaa(publicDnsAddr, corpSkyDnsAddr, LinkType-ClientNetSky-DnsComposed)

    --- Minio/S3 server
    aaa(s3SrvAddr, IXP-DEFAULT-ADDR, LinkType-MinioNet)
    aaa(IXP-DEFAULT-ADDR, s3SrvAddr, LinkType-MinioNet)

    --- Mastodon server
    aaa(masSrvAddr, IXP-DEFAULT-ADDR, LinkType-MastodonNet)
    aaa(IXP-DEFAULT-ADDR, masSrvAddr, LinkType-MastodonNet)
    aaa(corpMasNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon-Dns)
    aaa(IXP-DEFAULT-ADDR, corpMasNetClAddr, LinkType-ClientNetMastodon-Dns)
    aaa(corpMasNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetMastodon-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpMasNetClAddr, LinkType-ClientNetMastodon-DnsComposed)
    aaa(corpMasNetClAddr, publicDnsAddr, LinkType-ClientNetMastodon-DnsComposed)
    aaa(publicDnsAddr, corpMasNetClAddr, LinkType-ClientNetMastodon-DnsComposed)
    aaa(corpMasDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetMastodon-Dns)
    aaa(IXP-DEFAULT-ADDR, corpMasDnsAddr, LinkType-ClientNetMastodon-Dns)
    aaa(corpMasDnsAddr, publicDnsAddr, LinkType-ClientNetMastodon-DnsComposed)
    aaa(publicDnsAddr, corpMasDnsAddr, LinkType-ClientNetMastodon-DnsComposed)

    aaa(corpIodNetClAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetIodine-Dns)
    aaa(IXP-DEFAULT-ADDR, corpIodNetClAddr, LinkType-ClientNetIodine-Dns)
    aaa(corpIodNetClAddr, publicResolverNetSrvAddr, LinkType-ClientNetIodine-DnsComposed)
    aaa(publicResolverNetSrvAddr, corpIodNetClAddr, LinkType-ClientNetIodine-DnsComposed)
    aaa(corpIodNetClAddr, publicDnsAddr, LinkType-ClientNetIodine-DnsComposed)
    aaa(publicDnsAddr, corpIodNetClAddr, LinkType-ClientNetIodine-DnsComposed)
    aaa(corpIodDnsAddr, IXP-DEFAULT-ADDR, LinkType-ClientNetIodine-Dns)
