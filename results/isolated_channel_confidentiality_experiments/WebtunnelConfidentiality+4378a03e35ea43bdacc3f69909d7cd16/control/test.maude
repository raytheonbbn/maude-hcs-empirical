  eq gorTgenRt1UmAct  = mkTgenUMV2Actor(gorTgenRt1UmAddr, "gorilla-tgen-irc-7", gorTgenRt1TgAddr) .
  eq gorTgenRt1NetClAct = makeNetClient(gorTgenRt1NetClAddr,
