    aaa(corpIodDnsAddr, publicDnsAddr, LinkType-ClientNetIodine-DnsComposed)
    aaa(publicDnsAddr, corpIodDnsAddr, LinkType-ClientNetIodine-DnsComposed)

    aaa(servDnsAddr, IXP-DEFAULT-ADDR, LinkType-ServerNet-Dns)
