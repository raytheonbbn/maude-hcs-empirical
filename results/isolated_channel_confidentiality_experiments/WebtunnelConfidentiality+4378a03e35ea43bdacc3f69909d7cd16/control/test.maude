  eq gorTgenRt2Act    = mkGorillaChatTgenA(gorTgenRt2TgAddr, gorillaSrvAddr) .
  eq gorTgenRt2UmAct  = mkTgenUMV2Actor(gorTgenRt2UmAddr, "gorilla-tgen-irc-7", gorTgenRt2TgAddr) .
