                                  nullName) .

  ---------------------------------------------------
  --- Initial State Configuration
  ---------------------------------------------------
  op initState : Nat -> Config .
  eq initState(j) =

    --- Core Infrastructure
    ircServer s3SrvAct iodineMonitor masSrvAct
    mkIrcMonitor(ircMonitorAddr)
    servDns servNetCl
    advActor

    corpRtDns corpRtNetCl

    corpSkyDns corpSkyNetCl

    corpObfsDns corpObfsNetCl

    corpIodDns corpIodNetCl

    corpMasDns corpMasNetCl

    --- DNS Infrastructure
    publicResolver publicResolverNetSrv
    rootDns tldDns authDns

    --- TGEN Shared Servers
    ftpSrvAct ftpNetSrvAct
    gorillaSrvAct gorillaNetSrvAct
    ircTgenSrvNet

    --- TGEN Instances
    ircTgenRt1UmAct ircTgenRt1Act ircTgenRt1NetClAct
    ircTgenRt2UmAct ircTgenRt2Act ircTgenRt2NetClAct
    ircTgenRt3UmAct ircTgenRt3Act ircTgenRt3NetClAct
    ircTgenRt4UmAct ircTgenRt4Act ircTgenRt4NetClAct
    gorTgenRt1UmAct gorTgenRt1Act gorTgenRt1NetClAct
    gorTgenRt2UmAct gorTgenRt2Act gorTgenRt2NetClAct
    gorTgenRt3UmAct gorTgenRt3Act gorTgenRt3NetClAct
    gorTgenRt4UmAct gorTgenRt4Act gorTgenRt4NetClAct
    ftpTgenRt1UmAct ftpTgenRt1Act ftpTgenRt1NetClAct
    ftpTgenRt2UmAct ftpTgenRt2Act ftpTgenRt2NetClAct
    ftpTgenRt3UmAct ftpTgenRt3Act ftpTgenRt3NetClAct
    ftpTgenRt4UmAct ftpTgenRt4Act ftpTgenRt4NetClAct

    --- Startup Timers


    --- TGEN User Model Burst Delay Timers (staggered)
    [tgenDelay + genRandomX(j + 1, 0.0, 0.009), (to ircTgenRt1UmAddr from ircTgenRt1UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 2, 0.0, 0.009), (to ircTgenRt2UmAddr from ircTgenRt2UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 3, 0.0, 0.009), (to ircTgenRt3UmAddr from ircTgenRt3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 4, 0.0, 0.009), (to ircTgenRt4UmAddr from ircTgenRt4UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 5, 0.0, 0.009), (to gorTgenRt1UmAddr from gorTgenRt1UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 6, 0.0, 0.009), (to gorTgenRt2UmAddr from gorTgenRt2UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 7, 0.0, 0.009), (to gorTgenRt3UmAddr from gorTgenRt3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 8, 0.0, 0.009), (to gorTgenRt4UmAddr from gorTgenRt4UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 9, 0.0, 0.009), (to ftpTgenRt1UmAddr from ftpTgenRt1UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 10, 0.0, 0.009), (to ftpTgenRt2UmAddr from ftpTgenRt2UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 11, 0.0, 0.009), (to ftpTgenRt3UmAddr from ftpTgenRt3UmAddr : burstDelayTO), 0]
    [tgenDelay + genRandomX(j + 12, 0.0, 0.009), (to ftpTgenRt4UmAddr from ftpTgenRt4UmAddr : burstDelayTO), 0]

    rCtr(j + 14)
  .

  ---------------------------------------------------
  --- Run Limits and Initial Configuration
  ---------------------------------------------------
  ***** suppressing irc server dropping clients
  eq IRC-STALE-DURATION-S = 140000. [owise] .
  eq IRC-PING-INTV-S = 1200000. [owise]  .
  
  op slimit : -> Float .
  eq slimit = 610.0 [owise] .

  op initConfig : -> Config .
  rl[init]: initConfig => run({0.0 | nil} initState(counter), slimit) .

  op allClientsAddr : -> AddrList .
  eq allClientsAddr = nil .
endm
eof
--- set print attribute on .
--- rew initConfig .
--- q